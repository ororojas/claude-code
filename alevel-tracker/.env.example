# Supabase → Project Settings → API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects show an "anon" key instead. Either name works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: turns on the "Ask a follow-up" box in Teach Me mode.
# Leave unset and Teach Me still works from the built-in notes.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional no-login mode. With both set, opening the site signs you straight in
# as OWNER_EMAIL, so ANYONE with the site's address gets in as you. Never prefix
# these with NEXT_PUBLIC_. The secret key is in Supabase → Project Settings →
# API Keys → Secret keys (older projects: the service_role key).
# OWNER_EMAIL=you@example.com
# SUPABASE_SECRET_KEY=sb_secret_...
